# Image for the mock A2A test-execution agent and the scripted LLM mock. Unlike the
# plain recording mocks they import the framework's AgentBase and models, so they
# also need `common` and `config`.
FROM agentic-qa-base:latest

ARG WORK_DIR=/app
WORKDIR ${WORK_DIR}

COPY tests/smoke/mocks/ ${WORK_DIR}/mocks/
COPY common/ ${WORK_DIR}/common
COPY config.py ${WORK_DIR}/config.py

CMD gunicorn -w 1 -k uvicorn_worker.UvicornWorker --bind 0.0.0.0:$PORT mocks.execution_agent:app
